{
  "name": "collegepath-advisors",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "prisma generate && next build && node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint src prisma scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:promote": "tsx scripts/promote-user.ts"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.7",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "csv-parse": "^7.0.3",
    "lucide-react": "^1.55.0",
    "next": "^16.4.4",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.23.1"
  }
}
